{
  "name": "margin-desktop",
  "productName": "Margin",
  "version": "0.1.0",
  "private": true,
  "description": "Local personal writing dashboard for LA AI Hacks 2026",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "setup:electron": "node scripts/setup-electron.mjs",
    "predev": "npm run setup:electron",
    "prestart": "npm run setup:electron"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
